# ─── MySQL ───────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your-mysql-password
DB_NAME=pendaftaran-uib-db
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=25
DB_MAX_LIFETIME_MIN=30
DB_MAX_IDLE_LIFETIME_MIN=5

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://admin:<your-mongo-password-here>@mongodb:27017
MONGO_DB=pendaftaran-uib-db
MONGO_CONNECT_TIMEOUT=15
MONGO_PING_TIMEOUT=5

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# For development: use Mailtrap (https://mailtrap.io) — free email sandbox
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM=noreply@pendaftaran.uib.ac.id
SMTP_DISABLE_TLS=false

# ─── App ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your-very-secret-key-change-this
JWT_ISSUER=pendaftaran-uib
CORS_ORIGIN=http://localhost:8989
TURNSTILE_SECRET=your_turnstile_secret_key_here
TURNSTILE_EXPECTED_HOSTNAME=localhost
APP_ENV=development
APP_URL=http://localhost:8989
SERVER_PORT=9999
