@use 'utopia-core-scss/src/utopia' as utopia;
@use './_config.scss';

// ─── Fluid Scale (:root CSS custom properties) ────────────────────────────────
// Min viewport: 320px  →  Max viewport: 1400px (your xxl breakpoint)
//
// TYPE SCALE — var(--step-N) in any file, no @use needed
//   --step--2  ~11px → 13px   (tiny labels)
//   --step--1  ~13px → 16px   (nav links, buttons, captions)
//   --step-0   ~16px → 20px   (body / paragraph base)
//   --step-1   ~19px → 25px   (card titles, subheadings)
//   --step-2   ~23px → 31px   (section h3)
//   --step-3   ~28px → 39px   (section h2)
//   --step-4   ~33px → 49px   (hero h1)
//
// SPACE SCALE — var(--space-N) in any file, no @use needed
//   --space-2xs  ~8px  → 10px
//   --space-xs   ~12px → 15px
//   --space-s    ~16px → 20px   (base = same as step-0)
//   --space-m    ~24px → 30px
//   --space-l    ~32px → 40px
//   --space-xl   ~48px → 60px
//   --space-2xl  ~72px → 90px
//   One-up pairs also generated: --space-2xs-xs, --space-xs-s, etc.

:root {
  color-scheme: light dark;

  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;

  @include utopia.generateTypeScale((
    "minWidth":      320,
    "maxWidth":      1600,
    "minFontSize":   16,
    "maxFontSize":   20,
    "minTypeScale":  1.2,   // minor third — gentle on small screens
    "maxTypeScale":  1.25,  // major third — more expressive on large screens
    "positiveSteps": 4,
    "negativeSteps": 2,
  ));

  @include utopia.generateSpaceScale((
    "minWidth":       320,
    "maxWidth":       1600,
    "minSize":        16,
    "maxSize":        20,
    "positiveSteps":  (1.5, 2, 3, 4.5),  // → m, l, xl, 2xl
    "negativeSteps":  (0.75, 0.5),        // → xs, 2xs
  ));
}

html {
  box-sizing: border-box;
}

// Reset & Base
*, *:before, *:after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: config.$font-family;
  background-color: config.$background-color;
  line-height: 1.6;
  color: config.$text-color;

  h1 {
    font-size: var(--step-4);
  }

  h2 {
    font-size: var(--step-3);
  }

  h3 {
    font-size: var(--step-1);
  }

  h4 {
    font-size: var(--step-1);
  }

  p {
    font-size: var(--step-0);
  }
}

a {
  text-decoration: none;
}
