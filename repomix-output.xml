        {/* NAMA UNIVERSITAS */}
        <div className={form.formGroup}>
          <label className={form.label}>Nama Universitas *</label>
          <div className={form.selectWrapper}>
            <input
              className={form.input}
              name="universitas"
              value={queryUni}
              placeholder="Masukkan nama Universitas"
