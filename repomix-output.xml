services:
  mysql:
    image: mysql:8.0
    container_name: mysql-pendaftaran-uib-dev
    command: --port=${MYSQL_PORT}
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      MYSQL_USER: ${MYSQL_USER}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD}
      MYSQL_DATABASE: ${MYSQL_DATABASE}
    ports:
      - ${MYSQL_PORTS}
    volumes:
      - mysql_data:/var/lib/mysql
    healthcheck:
      test:
        [
          "CMD",
          "mysqladmin",
          "ping",
          "-h",
          "mysql",
          "-P",
          "${MYSQL_PORT}",
          "-u",
          "${MYSQL_USER}",
          "-p${MYSQL_PASSWORD}",
        ]
      interval: 10s
      timeout: 5s
      retries: 10

  phpmyadmin:
    image: phpmyadmin:latest
    container_name: phpmyadmin-pendaftaran-uib-dev
    depends_on:
      mysql:
        condition: service_healthy
    environment:
      PMA_HOST: mysql
      PMA_PORT: ${MYSQL_PORT}
      PMA_USER: ${MYSQL_USER}
      PMA_PASSWORD: ${MYSQL_PASSWORD}
    ports:
      - "8081:80"

  mongodb:
    image: mongo:7
    container_name: mongodb-pendaftaran-uib-dev
    command: >
      mongod
        --port ${MONGO_PORT}
        --auth
        --quiet
        --setParameter logComponentVerbosity={"storage":{"verbosity":-1}}
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${MONGO_USER}
      MONGO_INITDB_ROOT_PASSWORD: ${MONGO_PASSWORD}
      MONGO_INITDB_DATABASE: ${MONGO_DATABASE}
    ports:
      - ${MONGO_PORTS}
    volumes:
      - mongo_data:/data/db
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          mongosh --port ${MONGO_PORT} --username "${MONGO_USER}" --password
          "${MONGO_PASSWORD}" --authenticationDatabase admin --eval
          "db.adminCommand('ping')" --quiet
      interval: 10s
      timeout: 5s
      retries: 10

  mongo-express:
    image: mongo-express:latest
    container_name: mongo-express-pendaftaran-uib-dev
    depends_on:
      mongodb:
        condition: service_healthy
    environment:
      ME_CONFIG_MONGODB_ADMINUSERNAME: ${MONGO_USER}
      ME_CONFIG_MONGODB_ADMINPASSWORD: ${MONGO_PASSWORD}
      ME_CONFIG_MONGODB_SERVER: mongodb
      ME_CONFIG_MONGODB_PORT: ${MONGO_PORT}
      ME_CONFIG_MONGODB_URL: ${MONGO_URI}
      ME_CONFIG_BASICAUTH: false
    ports:
      - "8082:8081"

  migrate:
    build:
      context: ./backend
      target: development
    container_name: migrate-pendaftaran-uib-dev
    depends_on:
      mysql:
        condition: service_healthy
    environment:
      DB_HOST: mysql
      DB_PORT: ${MYSQL_PORT}
      DB_USER: ${MYSQL_USER}
      DB_PASSWORD: ${MYSQL_PASSWORD}
      DB_NAME: ${MYSQL_DATABASE}
    command: >-
      migrate -path /app/migrations -database
      "mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@tcp(mysql:${MYSQL_PORT})/${MYSQL_DATABASE}"
      up

  backend:
    build:
      context: ./backend
      target: development
    container_name: backend-pendaftaran-uib-dev
    depends_on:
      mysql:
        condition: service_healthy
      mongodb:
        condition: service_healthy
    environment:
      DB_HOST: mysql
      DB_PORT: ${MYSQL_PORT}
      DB_USER: ${MYSQL_USER}
      DB_PASSWORD: ${MYSQL_PASSWORD}
      DB_NAME: ${MYSQL_DATABASE}
      MONGO_URI: ${MONGO_URI}
      MONGO_DB: ${MONGO_DATABASE}
      JWT_SECRET: ${JWT_SECRET}
      CORS_ORIGIN: ${CORS_ORIGIN}
      TURNSTILE_SECRET: ${TURNSTILE_SECRET}
      APP_ENV: ${APP_ENV}
      SERVER_PORT: ${SERVER_PORT}
    ports:
      - ${BACKEND_PORTS}
    volumes:
      - ./backend:/app
      - /app/tmp
    command: air -c .air.toml

  frontend:
    build:
      context: ./frontend
      target: development
      args:
        - NEXT_PUBLIC_TURNSTILE_SITE_KEY=${NEXT_PUBLIC_TURNSTILE_SITE_KEY}
    container_name: frontend-pendaftaran-uib-dev
    depends_on:
      - backend
    environment:
      - NODE_ENV=${NODE_ENV}
      - BACKEND_URL=${BACKEND_URL}
      - WATCHPACK_POLLING=true
    ports:
      - ${FRONTEND_PORTS}
    volumes:
      - ./frontend:/app
      - /app/node_modules
      - /app/.next

volumes:
  mysql_data:
  mongo_data:
</file>

<file path="frontend/src/components/Header/Header.module.scss">
@use '@/styles/config.scss' as global;
@use 'sass:map';

$header-height: var(--space-2xl);
$mobile-nav-bg: #868686;

.header {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: $header-height;
  background: transparent;
  transition: background 0.4s, box-shadow 0.3s;
  z-index: 999;

  &.fixed {
    position: fixed;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    height: calc(var(--space-2xl) * 0.85);
    box-shadow: 0px 3px 16px 0px rgba(0, 0, 0, 0.1);
    animation: slideDown 0.3s ease forwards;
  }

  .container {
    @include global.container;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }
}

@keyframes slideDown {
  from { transform: translateY(-100%) }
  to { transform: translateY(0) }
}

.logoUIB {
  img {
    display: block;
    width: auto;
    height: auto;
  }
}

.nav{
  display: flex;
  align-items: center;
  justify-content: space-between;

  .menu {
    display: flex;
    list-style: none;
    gap: var(--space-l);

    .navLink {
      font-size: var(--step--1);
      font-weight: 500;
      line-height: $header-height;
      color: global.$tertiary-color;
      padding: 0;
      display: inline-block;
      transition: color 0.3s ease;
      white-space: nowrap;

      &:hover, &.active {
        color: global.$primary-color;
      }
    }
  }
}

.toggler {
  display: none;
  cursor: pointer;
  border: none;
  border-radius: 0;
  background: transparent;
  padding: 0;

  .iconBar {
    display: block;
    width: clamp(1.5625rem, 1.2777rem + 1.2658vw, 2.0625rem);
    height: clamp(0.1875rem, 0.1519rem + 0.1582vw, 0.25rem);
    margin: auto auto clamp(0.25rem, 0.1788rem + 0.3165vw, 0.375rem) auto;
    background-color: global.$primary-color;
    transition: all 0.4s linear;
  }
}

.toggler.openState {
  $offset: clamp(0.4375rem, 0.3307rem + 0.4747vw, 0.625rem);

  .iconBar:nth-child(1) {
