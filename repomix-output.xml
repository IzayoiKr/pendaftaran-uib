  background: global.$card-bg;
  position: relative;
  transition: background 0.3s ease;
}

.badge {
  position: absolute;
  top: clamp(-2rem, -1.5161rem + -0.4839vw, -1.625rem);
  right: clamp(0.625rem, 0.5469rem + 0.3906vw, 0.9375rem);
  width: $badge-size;
  height: $badge-size;
  line-height: $badge-size;
  text-align: center;
  border-radius: 50%;
  background: global.$primary-color;
  color: global.$tertiary-color;
  font-size: $badge-font;
  font-weight: 500;
  transition: background 0.3s ease, color 0.3s ease;
}

.tag {
  display: inline-block;
  padding: 2px clamp(0.875rem, 0.7656rem + 0.5469vw, 1.3125rem);
  font-size: clamp(0.6875rem, 0.6563rem + 0.1563vw, 0.8125rem);
  color: global.$card-bg;
  background: global.$tertiary-color;
  text-transform: uppercase;
  margin-bottom: var(--space-xs);
}

.courseContent {
  h3 {
  font-weight: 500;
  margin-bottom: var(--space-xs);

    a {
      color: global.$tertiary-color;
      transition: color 0.3s ease;
    }
  }

  p {
    font-size: var(--step--1);
    color: global.$text-color;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    text-wrap: pretty;
    line-height: 1.7;
  }
}

.navBtn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);

  width: $navBtn-size;
  height: $navBtn-size;
  border-radius: 50%;
  border: 2px solid global.$primary-color;
  background: transparent;
  color: global.$primary-color;
  font-size: $navBtn-arrow;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s ease, color 0.3s ease;

  &:hover {
    background: global.$primary-color;
