            {openUni && (
              <div className={form.dropdown}>
                {filteredUni.length === 0 ? (
                  <div className={form.notFound}>Universitas tidak ditemukan</div>
                ) : (
                  filteredUni.map((u: string, i: number) => (
                    <div
                      key={i}
                      className={form.option}
                      onMouseDown={() => selectUniversity(u)}
