        "registrationRequirements": {
            "heading": "New Undergraduate Student Registration Requirements Academic Year 2024/2025",
            "sections": [
                {
                    "id": "regular",
                    "heading": "Regular Admission Registration Requirements",
                    "description": "The requirements or conditions for registering as a new student candidate are as follows:",
                    "items": [
                        {
                            "text": "Fill out the registration form;"
                        },
                        {
                            "text": "Copy of Family Card and Identity Card (ID Card/Student Card/Passport), scanned in PDF format with a maximum size of 2 MB."
                        },
                        {
                            "text": "2×3 softcopy photograph with blue background and wearing a white shirt;"
                        },
                        {
                            "text": "Pay the registration fee amounting to:",
                            "subItems": [
                                "Rp 250.000,- for Regular Admission",
                                "Rp 150.000,- for Scholarship Admission"
                            ],
                            "callout": "For Scholarship Admission registration, complete requirements can be found in the Scholarship menu."
                        },
                        {
                            "text": "All documents above must be completed during registration in the available registration wave in the registration account."
                        }
                    ]
                },
                {
                    "id": "scholarship",
                    "heading": "Scholarship Admission Registration Requirements",
                    "items": [
                        {
                            "text": "Indonesian citizen;"
                        },
                        {
                            "text": "Maximum age of 21 years old;"
                        },
                        {
                            "text": "Graduated from SMA/SMK/MA/equivalent in 2022 or 2023;"
                        },
                        {
                            "text": "Applying for S-1 (Bachelor Degree) level;"
                        },
                        {
                            "text": "Softcopy scan of Family Card in PDF format with maximum size of 2 MB;"
                        },
                        {
                            "text": "Softcopy scan of ID Card/Student Card/Passport in PDF format with maximum size of 2 MB;"
                        },
                        {
                            "text": "2×3 blue background passport photo in PDF format with maximum size of 2 MB;"
                        },
                        {
                            "text": "Fill in the average report card scores from semester 1 to semester 4;"
                        },
                        {
                            "text": "Fill out the registration form in the scholarship registration wave."
                        }
                    ]
                },
                {
                    "id": "transfer",
                    "heading": "Transfer Student Registration Requirements",
                    "description": "The following are the registration requirements as a transfer student at Universitas Internasional Batam:",
                    "items": [
                        {
                            "text": "Submit academic transcripts from previous education.",
                            "emailInfo": {
                                "label": "Documents should be sent via email:",
                                "emails": [
                                    "humas@uib.ac.id",
                                    "CC: humas.uib@gmail.com"
                                ]
                            },
                            "includeLabel": "Include:",
                            "includeItems": [
                                "Full name",
                                "Contactable phone number",
                                "Destination study program"
                            ]
                        },
                        {
                            "text": "The university will conduct transcript equalization to the selected study program;"
                        },
                        {
                            "text": "The equalization form signed by Vice Rector I will be sent to the applicant via email, then the applicant may continue the registration process and UIB Entrance Examination."
                        }
                    ]
                },
                {
                    "id": "overseas",
                    "heading": "Registration Requirements for Overseas Graduates (High School or Diploma)",
                    "paragraphs": [
                        "Diploma and Bachelor Degree (S1) certificates originating from overseas must be equalized at KEMENRISTEKDIKTI Jakarta.",
                        "Meanwhile, high school certificates must be equalized at the Ministry of Education and Culture Jakarta.",
                        "Applicants may also attach Paket C certificates and SKHU that have already been issued.",
                        "Documents should be sent via email: humas@uib.ac.id"
                    ],
                    "callout": {
                        "heading": "Note:",
                        "description": "The equalization process is carried out online through the official website of the related institution."
                    }
                }
            ]
        },
        "studentAssistance": {
            "paragraphs": [
                "Prospective new students who come from outside the Batam area will be facilitated with pick-up, transportation, and preparation for accommodation in Batam City.",
                "The student pick-up service is carried out when prospective students arrive at the airport or port and are transported to the UIB campus.",
                "Afterward, students will also be assisted with transportation for shopping accommodation necessities and going to their residence, either at the UIB dormitory or nearby boarding houses around the UIB campus.",
                "This student assistance service is available for all prospective UIB students who are interested or willing to use the service.",
                "Students will also continue to be accompanied by Public Relations staff for their comfort and safety."
            ],
            "contact": {
                "heading": "Contact",
                "description": "For prospective students from outside Batam who would like to receive this service, please contact humas@uib.ac.id."
            }
        },
        "residence": {
            "heading": "Nearest Residence Information for Universitas Internasional Batam Students",
            "dormitoryInfo": {
                "heading": "UIB Dormitory Information",
                "paragraphs": [
                    "The Universitas Internasional Batam Dormitory has been operating since 2019 with one main building and a residential capacity of 96 female students and 104 male students.",
                    "The dormitory is designed to provide a safe, comfortable, and supportive living environment for students during their academic journey at UIB.",
                    "Prospective students who are interested in staying at the UIB dormitory may contact the UIB Public Relations WhatsApp number at 0812-7526-2369."
                ]
            },
            "gallery": {
                "heading": "Dormitory Gallery",
                "items": [
                    {
                        "image": "/images/infoumum/asrama2.png",
                        "title": "Dormitory Room",
                        "description": "The room facilities include bunk beds, study desks, chairs, and storage cabinets to support student comfort.",
                        "alt": "Universitas Internasional Batam Dormitory Room"
                    },
                    {
                        "image": "/images/infoumum/asrama1.png",
                        "title": "Dormitory Environment",
                        "description": "The dormitory area has a clean and organized environment that supports student activities and interactions while living in Batam.",
                        "alt": "Universitas Internasional Batam Dormitory Environment"
                    }
                ]
            }
        },
        "entranceExam": {
            "heading": "Entrance Examination for New Undergraduate Students",
            "paragraphs": [
                "Every prospective applicant for the Scholarship and Regular Admission pathways is required to take the Entrance Examination held by Universitas Internasional Batam.",
                "The stages, requirements, and procedures for the Entrance Examination are as follows:"
            ],
            "examStages": {
                "heading": "Entrance Examination Stages",
                "description": "The Universitas Internasional Batam Entrance Examination consists of:",
                "items": [
                    {
                        "title": "Computer Based Test or Academic Potential Test (Mathematics, Indonesian, and English).",
                        "description": "The test duration is 90 – 120 minutes."
                    },
                    {
                        "title": "Interview or Interview Test with Universitas Internasional Batam lecturers.",
                        "description": "The interview is conducted within 5 – 10 minutes."
                    }
                ]
            },
            "offlineConditions": {
                "heading": "Conditions for Taking the Offline Entrance Examination",
                "items": [
                    {
                        "text": "Wear a white shirt, black pants (non-jeans material), and shoes;"
                    },
                    {
                        "text": "Bring a personal identity card such as ID Card/Student Card/Passport/Driver's License."
                    },
                    {
                        "text": "The Entrance Examination results will be announced 2 days after the examination and can be viewed on the official website and social media of Universitas Internasional Batam."
                    }
                ]
            },
            "onlineConditions": {
                "heading": "Conditions for Taking the Online Entrance Examination",
                "items": [
                    {
                        "text": "Wear appropriate and polite clothing;"
                    },
                    {
                        "text": "Follow the procedures for conducting the online examination (system trial, online interview, and online written test).",
                        "description": "The procedure guide will be provided by the committee one day before the online examination."
                    },
                    {
                        "text": "The Entrance Examination results will be announced 2 days after the examination and can be viewed on the official website and social media of Universitas Internasional Batam."
                    }
                ]
            }
        },
        "videoTutorial": {
            "heading": "Online Registration Tutorial for Prospective Batam International University Students",
            "description": "For online registration guidelines, potential participants can access the video below.",
            "video": {
                "title": "Online Registration Tutorial for Prospective Batam International University Students",
