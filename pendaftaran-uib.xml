  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--step--2);
  font-weight: 700;
  flex-shrink: 0;
  transition: all 0.2s ease;

  &.empty {
    border: 2px solid $status-empty;
    background: transparent;
    color: $status-empty;
  }

  &.partial {
    background: $status-partial;
    color: white;
    border: 2px solid $status-partial;
  }

  &.complete {
    background: $status-complete;
    color: white;
    border: 2px solid $status-complete;
    font-size: 14px;
  }
}
