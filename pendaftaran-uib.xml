);

@mixin down($breakpoint) {
  $bp: map.get($breakpoints, $breakpoint);
  @if $bp == null {
    @error "Unknown breakpoint: #{$breakpoint}";
  }
  @media (max-width: calc(#{$bp} - 0.02px)) {
    @content;
  }
}

@mixin up($breakpoint) {
  $bp: map.get($breakpoints, $breakpoint);
  @if $bp == null {
    @error "Unknown breakpoint: #{$breakpoint}";
  }
  @media (min-width: $bp) {
    @content;
  }
}

@mixin hover-supported {
  @media (hover: hover) and (pointer: fine) {
    &:hover {
      @content;
    }
  }
}

@mixin flex-column($gap: null) {
  display: flex;
  flex-direction: column;
  @if $gap != null {
    gap: $gap;
  }
}

@mixin flex-row($gap: null, $align: center, $justify: null) {
  display: flex;
  align-items: $align;
  @if $justify != null {
    justify-content: $justify;
  }
  @if $gap != null {
    gap: $gap;
  }
}

@mixin flex-center($gap: null) {
  display: flex;
  align-items: center;
  justify-content: center;
  @if $gap != null {
    gap: $gap;
  }
}

@mixin flex-between($gap: null) {
  display: flex;
  align-items: center;
  justify-content: space-between;
  @if $gap != null {
    gap: $gap;
  }
}

@mixin absolute-fill {
  position: absolute;
  inset: 0;
}

@mixin text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@mixin line-clamp($lines) {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: $lines;
  -webkit-box-orient: vertical;
}

@mixin visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

@mixin scrollbar-hidden {
  scrollbar-width: none;
  &::-webkit-scrollbar {
    display: none;
  }
}

@mixin interactive {
  cursor: pointer;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}

@mixin focus-ring($color: $primary-color, $offset: 2px, $radius: $radius-xs) {
  &:focus-visible {
    outline: 2px solid $color;
    outline-offset: $offset;
    border-radius: $radius;
  }
}

@mixin glass-card($bg: rgb(255 255 255 / 8%)) {
  background: $bg;
  border: 1px solid $border-subtle;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

@mixin warning-surface {
  background: rgb(253 198 50 / 10%);
  border: 1px solid rgb(253 198 50 / 24%);
}

@mixin card-surface {
  background: $background-color;
  border: 1px solid $border-light;
  border-radius: $radius-lg;
  box-shadow: $shadow-sm;
}

@mixin section-spacing {
  padding-block: clamp(3rem, 6vw, 5rem);
}

@mixin main-layout {
  @include flex-center;
  margin: calc(var(--space-2xl) + var(--space-xl)) 0 var(--space-2xl);
}

@mixin container($padding: 1rem) {
  width: 100%;
  margin-inline: auto;
