// ─── Letter Container ──────────────────────────────────────────────────────────
.letter {
  max-width: 800px;
  width: 100%;
  background: white;
  padding: 50px 60px;
  box-shadow: var(--shadow);
  border-radius: 4px;
  position: relative;
  border-top: 6px solid var(--primary);
}

// ─── Print Button ──────────────────────────────────────────────────────────────
.print-btn {
  position: fixed;
  top: 20px;
  right: 20px;
  background: var(--primary);
  color: white;
  border: none;
  border-radius: 6px;
  padding: 10px 22px;
  font-size: 13pt;
  cursor: pointer;
  font-family: sans-serif;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  z-index: 100;

  &:hover {
    background: #122d52;
  }
}

// ─── Header ───────────────────────────────────────────────────────────────────
.header {
  display: flex;
  align-items: flex-start;
  gap: 20px;
  margin-bottom: 25px;
}

.logo {
  flex: 0 0 90px;

  img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
}

.school-info {
  flex: 1;
  font-size: 10pt;
