@use "@/styles/config.scss" as global;
@use "sass:map";

$surface: #ffffff;
$border-subtle: #e5e7eb;
$text-secondary: #6b7280;
$text-primary: #111827;
$accent: #002347;
$accent-light: #f0f4ff;
