<file path="frontend/src/pages/InfoUmum/InfoUmum.tsx">
"use client";

import { useMemo, useState } from "react";
import { useTranslations } from "next-intl";
import { infoList } from "@/constants/infoUmum";
import clsx from "clsx";
import InfoCard from "./InfoCard";
import styles from "./InfoUmum.module.scss";

const ITEMS_PER_PAGE = 6;

export default function InfoUmum() {
    const t = useTranslations();

    const [currentPage, setCurrentPage] = useState(1);

    const totalPages = Math.ceil(infoList.length / ITEMS_PER_PAGE);

    const currentItems = useMemo(() => {
        const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;

        return infoList.slice(startIndex, startIndex + ITEMS_PER_PAGE);
    }, [currentPage]);

    return (
        <section className={styles.section}>
            {infoList.length > 0 ? (
                <>
                    <div className={styles.grid}>
                        {currentItems.map((post) => (
                            <InfoCard key={post.id} post={post} />
                        ))}
                    </div>

                    {totalPages > 1 && (
                        <div className={styles.pagination}>
                            <button
                                type="button"
                                className={clsx(
                                    styles.pageButton,
                                    currentPage === 1 && styles.disabled,
                                )}
                                disabled={currentPage === 1}
                                onClick={() =>
                                    setCurrentPage((prev) => prev - 1)
                                }
                            >
                                Prev
                            </button>

                            <div className={styles.pageNumbers}>
                                {Array.from(
                                    { length: totalPages },
                                    (_, index) => {
                                        const page = index + 1;

                                        return (
                                            <button
                                                key={page}
                                                type="button"
                                                className={clsx(
                                                    styles.pageButton,
                                                    currentPage === page &&
                                                        styles.activePage,
                                                )}
                                                onClick={() =>
                                                    setCurrentPage(page)
                                                }
                                            >
                                                {page}
                                            </button>
                                        );
                                    },
                                )}
                            </div>

                            <button
                                type="button"
                                className={clsx(
                                    styles.pageButton,
                                    currentPage === totalPages &&
                                        styles.disabled,
                                )}
                                disabled={currentPage === totalPages}
                                onClick={() =>
                                    setCurrentPage((prev) => prev + 1)
                                }
                            >
                                Next
                            </button>
                        </div>
                    )}
                </>
            ) : (
                <div className={styles.empty}>
                    <p>{t("infoUmum.empty")}</p>
                </div>
            )}
        </section>
    );
}
</file>

<file path="frontend/src/pages/Prodi/Prodi.tsx">
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import { toast } from "sonner";
import type { ProdiInfoResponse, ProgramChoice, ProdiRequestItem } from "@/types/api";
import ConfirmDialog from "@/components/ConfirmDialog/ConfirmDialog";
import { useConfirm } from "@/components/ConfirmDialog/useConfirm";
import {
    CheckIcon,
    ClockIcon,
    FileIcon,
    TrashIcon,
    WarningIcon,
} from "@/components/Icons/Icons";
import ProdiSkeleton from "./Prodi.skeleton";
import styles from "./Prodi.module.scss";
import { api } from "@/api";

interface ProdiProps {
    regID: string;
}

const SHIFT_OPTIONS = [
    { value: "PAGI", label: "Pagi" },
    { value: "MALAM", label: "Malam" },
];

function StatusBadge({ status }: { status: ProdiRequestItem["status"] }) {
    const config = {
        PENDING: {
            label: "MENUNGGU",
            color: "pending",
            icon: <ClockIcon className={styles.statusIconSvg} />,
        },
        APPROVED: {
            label: "DISETUJUI",
            color: "approved",
            icon: <CheckIcon className={styles.statusIconSvg} />,
        },
        REJECTED: {
            label: "DITOLAK",
            color: "rejected",
            icon: <WarningIcon className={styles.statusIconSvg} />,
        },
    };
    const c = config[status];
    return (
        <span className={styles.statusBadge} data-status={c.color}>
            {c.icon}
            {c.label}
        </span>
    );
}

function formatShift(shift: string): string {
    if (!shift) return shift;
    return shift.charAt(0) + shift.slice(1).toLowerCase();
}

export default function Prodi({ regID }: ProdiProps) {
    const router = useRouter();

    const [data, setData] = useState<ProdiInfoResponse | null>(null);
    const [isLoading, setIsLoading] = useState(true);
    const [isSubmitting, setIsSubmitting] = useState(false);
    const [isCancelling, setIsCancelling] = useState<string | null>(null);
    const [newProdi, setNewProdi] = useState("");
    const [newShift, setNewShift] = useState("");

    const { confirm, dialogProps, setLoading } = useConfirm();

    const hasPending = useMemo(
        () => data?.requests.some((r) => r.status === "PENDING") ?? false,
        [data],
    );

    const load = useCallback(async () => {
        setIsLoading(true);
        try {
            const res = await api.prodi.get(regID);
            setData(res);
            setNewProdi("");
            setNewShift("");
        } catch (err) {
            toast.error(
                err instanceof Error ? err.message : "Gagal memuat data",
            );
        } finally {
            setIsLoading(false);
        }
    }, [regID]);

    useEffect(() => {
        load();
    }, [load]);

    const handleSubmit = async (e: React.FormEvent) => {
        e.preventDefault();
        if (!newProdi || !newShift) {
            toast.error("Mohon lengkapi semua field");
            return;
        }
        if (
            newProdi === data?.current_prodi &&
            newShift === data?.current_shift
        ) {
            toast.error(
                "Program studi dan waktu kuliah baru tidak boleh sama dengan saat ini",
            );
            return;
        }

        setIsSubmitting(true);
        const toastId = toast.loading("Mengajukan...");
        try {
            await api.prodi.post(regID, newProdi, newShift);
            toast.success("Permintaan berhasil diajukan", { id: toastId });
            await load();
        } catch (err) {
            toast.error(
                err instanceof Error
                    ? err.message
                    : "Gagal mengajukan permintaan",
                { id: toastId },
            );
        } finally {
            setIsSubmitting(false);
        }
    };

    const handleCancel = async (requestId: string) => {
        const confirmed = await confirm({
            title: "Batalkan Permintaan",
            message: "Apakah Anda yakin ingin membatalkan permintaan ini?",
            confirmLabel: "Ya, Batalkan",
            cancelLabel: "Tidak",
            variant: "danger",
        });
        if (!confirmed) return;

        setIsCancelling(requestId);
        setLoading(true);
        const toastId = toast.loading("Membatalkan...");
        try {
            await api.prodi.delete(regID, requestId);
            toast.success("Permintaan berhasil dibatalkan", { id: toastId });
            await load();
        } catch (err) {
            toast.error(
                err instanceof Error
                    ? err.message
                    : "Gagal membatalkan permintaan",
                { id: toastId },
            );
        } finally {
            setIsCancelling(null);
            setLoading(false);
        }
    };

    if (isLoading) return <ProdiSkeleton />;
    if (!data) return null;

    return (
        <section className={styles.prodi}>
            <div className={styles.prodiContent}>
                <div className={styles.pageHeader}>
                    <button
                        type="button"
                        className={styles.backLink}
                        onClick={() => router.push("/account")}
                    >
                        <svg
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            strokeWidth="2"
                            strokeLinecap="round"
                            strokeLinejoin="round"
                        >
                            <path d="M19 12H5M12 19l-7-7 7-7" />
                        </svg>
                        Kembali ke Akun
                    </button>
                </div>

                <div className={styles.layoutGrid}>
                    <div className={styles.mainColumn}>
                        <div className={styles.card}>
                            <div className={styles.cardHeader}>
                                <ClockIcon className={styles.cardHeaderIcon} />
                                <h2 className={styles.cardTitle}>
                                    Riwayat Permintaan
                                </h2>
                            </div>

                            {data.requests.length === 0 ? (
                                <div className={styles.emptyState}>
                                    <FileIcon className={styles.emptyIcon} />
                                    <h3 className={styles.emptyTitle}>
                                        Belum ada permintaan
                                    </h3>
                                    <p className={styles.emptyText}>
                                        Anda belum pernah mengajukan perubahan
                                        program studi.
                                    </p>
                                </div>
                            ) : (
                                <div className={styles.historyList}>
                                    {data.requests.map((req) => (
                                        <div
                                            key={req.id}
                                            className={styles.historyItem}
                                        >
                                            <div className={styles.itemHeader}>
                                                <div
                                                    className={styles.itemDate}
                                                >
                                                    <span
                                                        className={
                                                            styles.dateDay
                                                        }
                                                    >
                                                        {new Date(
                                                            req.request_date,
                                                        ).getDate()}
                                                    </span>
                                                    <span
                                                        className={
                                                            styles.dateMonth
                                                        }
                                                    >
                                                        {new Date(
                                                            req.request_date,
                                                        ).toLocaleDateString(
                                                            "id-ID",
                                                            {
